---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import SkinQuiz from '../../components/quiz/SkinQuiz.jsx';
import { getTranslations } from '../../i18n/utils';

const lang = 'en';
const t = getTranslations(lang);
---

<BaseLayout title={t.quiz.title} description={t.quiz.subtitle} lang={lang}>
  <section class="py-8 sm:py-12">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <div class="mb-6 space-y-2 text-center">
        <h1 class="text-2xl font-semibold text-foreground sm:text-3xl">{t.quiz.title}</h1>
        <p class="text-muted-foreground">{t.quiz.subtitle}</p>
      </div>
      <SkinQuiz client:load lang={lang} t={t} />
    </div>
  </section>
</BaseLayout>
