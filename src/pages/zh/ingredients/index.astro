---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import IngredientIndex from '../../../components/ingredients/IngredientIndex.jsx';
import { getTranslations } from '../../../i18n/utils';
import { ALL_INGREDIENTS, INGREDIENT_CATEGORIES, ingredientSlug } from '../../../lib/ingredients';

export const prerender = true;

const lang = 'zh';
const t = getTranslations(lang);

const items = ALL_INGREDIENTS.map((i) => ({
  id: i.id,
  slug: ingredientSlug(i.id),
  inci_name: i.inci_name,
  chinese_name: i.chinese_name,
  aliases: [...(i.aliases_en ?? []), ...(i.aliases_zh ?? [])],
  category: i.category,
  blurb: i.functions?.zh?.[0] || i.notes_zh || '',
})).sort((a, b) => a.chinese_name.localeCompare(b.chinese_name, 'zh'));
---

<BaseLayout title={t.ingredients.index_title} description={t.ingredients.index_subtitle} lang={lang}>
  <section class="py-8 sm:py-10 lg:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 space-y-2">
        <h1 class="text-2xl font-semibold text-foreground sm:text-3xl">{t.ingredients.index_title}</h1>
        <p class="text-muted-foreground">{t.ingredients.index_subtitle}</p>
      </div>
      <IngredientIndex client:load items={items} categories={INGREDIENT_CATEGORIES} lang={lang} t={t} />
    </div>
  </section>
</BaseLayout>
