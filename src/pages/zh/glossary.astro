---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import GlossaryTable from '../../components/glossary/GlossaryTable.jsx';
import { getTranslations } from '../../i18n/utils';
import glossaryData from '../../data/glossary-data.json';
import { idByInci, ingredientSlug } from '../../lib/ingredients';

const lang = 'zh';
const t = getTranslations(lang);

// Link each glossary row to its detail page when a matching entry exists.
const entries = glossaryData.entries.map((e) => {
  const id = idByInci(e.inci_name);
  return { ...e, href: id ? `/${lang}/ingredients/${ingredientSlug(id)}` : null };
});
---

<BaseLayout
  title={t.glossary.title}
  description={t.glossary.subtitle}
  lang={lang}
>
  <section class="py-8 sm:py-10 lg:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 space-y-2">
        <h1 class="text-2xl font-semibold text-foreground sm:text-3xl">{t.glossary.title}</h1>
        <p class="text-muted-foreground">{t.glossary.subtitle}</p>
        <a
          href={`/${lang}/ingredients`}
          class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
        >
          {t.ingredients.detail_from_glossary}
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <GlossaryTable
        client:load
        entries={entries}
        categories={glossaryData.categories}
        lang={lang}
        translations={t}
      />
    </div>
  </section>
</BaseLayout>
