---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Hero from '../../components/marketing/Hero.astro';
import TrustStrip from '../../components/marketing/TrustStrip.astro';
import Features from '../../components/marketing/Features.astro';
import AiHowItWorks from '../../components/marketing/AiHowItWorks.astro';
import Steps from '../../components/marketing/Steps.astro';
import CtaBand from '../../components/marketing/CtaBand.astro';
import { getTranslations } from '../../i18n/utils';

const lang = 'zh';
const t = getTranslations(lang);
---

<BaseLayout
  title={t.home.hero_title}
  description={t.site.description}
  lang={lang}
>
  <Hero lang={lang} t={t} />
  <TrustStrip t={t} />

  <div class="gradient-divider"></div>

  <Features t={t} />

  <div class="gradient-divider"></div>

  <AiHowItWorks t={t} />

  <div class="gradient-divider"></div>

  <Steps lang={lang} t={t} />

  <CtaBand lang={lang} t={t} />
</BaseLayout>
