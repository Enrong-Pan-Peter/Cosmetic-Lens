---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import RoutineChecker from '../../components/routine/RoutineChecker.jsx';
import { getTranslations } from '../../i18n/utils';

const lang = 'zh';
const t = getTranslations(lang);
---

<BaseLayout title={t.routine.title} description={t.routine.subtitle} lang={lang}>
  <section class="py-8 sm:py-10 lg:py-14">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 space-y-2">
        <h1 class="text-2xl font-semibold text-foreground sm:text-3xl">{t.routine.title}</h1>
        <p class="text-muted-foreground">{t.routine.subtitle}</p>
      </div>
      <RoutineChecker client:load lang={lang} t={t} />
    </div>
  </section>
</BaseLayout>
