---
import LanguageSwitcher from './LanguageSwitcher.jsx';
import { getTranslations } from '../../i18n/utils';

export interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: `/${lang}/`, label: t.nav.home },
  { href: `/${lang}/chat`, label: t.nav.analyze },
  { href: `/${lang}/routine`, label: t.nav.routine },
  { href: `/${lang}/glossary`, label: t.nav.glossary },
  { href: `/${lang}/education`, label: t.nav.education },
];
---

<header class="bg-background/95 backdrop-blur sticky top-0 z-50 masthead">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <!-- Logo: spaced-caps wordmark, petrol flask -->
    <a href={`/${lang}/`} class="flex items-center gap-2.5 group">
      <svg class="w-5 h-5 text-brand" viewBox="0 0 256 256" fill="currentColor"><path d="M224,208H203.94A88.05,88.05,0,0,0,144,64.37V32a16,16,0,0,0-16-16H80A16,16,0,0,0,64,32V136a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V80.46A72,72,0,0,1,181.25,208H32a8,8,0,0,0,0,16H224a8,8,0,0,0,0-16Zm-96-72H80V32h48V136ZM72,184a8,8,0,0,1,0-16h64a8,8,0,0,1,0,16Z" /></svg>
      <span class={`wordmark text-foreground ${lang === 'zh' ? 'text-[0.9375rem]' : ''}`}>
        {lang === 'zh' ? '成分透视' : 'COSMETIC LENS'}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`whitespace-nowrap text-base font-medium transition-colors ${
            currentPath === link.href
              ? 'text-foreground'
              : 'text-muted-foreground hover:text-foreground'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right side: Auth + Language + Mobile -->
    <div class="flex items-center gap-3">
      <!-- Theme toggle (13.1) — icons swap via the .dark class, no JS needed -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-input bg-background text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
      >
        <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>
      <LanguageSwitcher client:load lang={lang} currentPath={currentPath} />

      <!-- Account menu (shown when logged out): collapsible, so auth stays
           discoverable while Analyze keeps the only filled button -->
      <div id="auth-buttons" class="hidden items-center">
        <div class="relative">
          <button
            id="account-button"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            class="inline-flex h-9 items-center gap-1.5 whitespace-nowrap rounded-md border border-input bg-background px-3 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            {t.nav.account}
            <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div
            id="account-dropdown"
            class="hidden absolute right-0 mt-2 w-56 rounded-lg border border-border bg-card shadow-md z-50 py-1.5"
            role="menu"
          >
            <p class="px-4 pb-2 pt-1 text-[11px] leading-snug text-muted-foreground border-b border-border">
              {t.nav.account_hint}
            </p>
            <a
              href={`/${lang}/login`}
              role="menuitem"
              class="block px-4 py-2 text-sm font-medium text-foreground hover:bg-accent transition-colors"
            >
              {t.nav.login}
            </a>
            <a
              href={`/${lang}/signup`}
              role="menuitem"
              class="block px-4 py-2 text-sm font-semibold text-foreground hover:bg-accent transition-colors"
            >
              {t.nav.signup}
            </a>
          </div>
        </div>
      </div>

      <!-- Primary product CTA: the tool, not the account (hidden on the chat page itself) -->
      {!currentPath.includes('/chat') && (
        <a
          href={`/${lang}/chat`}
          class="hidden md:inline-flex h-9 items-center whitespace-nowrap rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          {t.home.cta_analyze}
        </a>
      )}

      <!-- Profile dropdown (shown when logged in) -->
      <div id="profile-menu" class="hidden relative">
        <button
          id="profile-button"
          class="flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground px-2 py-1.5 rounded-lg hover:bg-accent transition-colors"
        >
          <span class="w-7 h-7 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="profile-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-background rounded-lg shadow-lg border border-border z-50 py-1">
          <a
            href={`/${lang}/profile`}
            class="block px-4 py-2 text-sm text-foreground hover:bg-accent transition-colors"
          >
            {t.nav.profile}
          </a>
          <a
            href={`/${lang}/history`}
            class="block px-4 py-2 text-sm text-foreground hover:bg-accent transition-colors"
          >
            {t.nav.history}
          </a>
          <div class="border-t border-border my-1"></div>
          <button
            id="logout-button"
            class="w-full text-left px-4 py-2 text-sm text-destructive hover:bg-accent transition-colors"
          >
            {t.nav.logout}
          </button>
        </div>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="md:hidden inline-flex items-center justify-center h-9 w-9 rounded-md border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Gradient divider line -->
  <div class="gradient-divider"></div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-border bg-background">
    <div class="mx-auto max-w-5xl px-4 py-3 space-y-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`block rounded-md px-3 py-2 text-base font-medium transition-colors ${
            currentPath === link.href
              ? 'bg-accent text-accent-foreground'
              : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="border-t border-border my-2 pt-2">
        <div id="mobile-auth-buttons">
          <a
            href={`/${lang}/login`}
            class="block rounded-md px-3 py-2 text-base font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          >
            {t.nav.login}
          </a>
          <a
            href={`/${lang}/signup`}
            class="block rounded-md px-3 py-2 text-base font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          >
            {t.nav.signup}
          </a>
        </div>
        <div id="mobile-profile-links" class="hidden">
          <a
            href={`/${lang}/profile`}
            class="block rounded-md px-3 py-2 text-base font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          >
            {t.nav.profile}
          </a>
          <a
            href={`/${lang}/history`}
            class="block rounded-md px-3 py-2 text-base font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground"
          >
            {t.nav.history}
          </a>
          <button
            id="mobile-logout-button"
            class="block w-full text-left rounded-md px-3 py-2 text-base font-medium text-destructive hover:bg-accent"
          >
            {t.nav.logout}
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { supabase } from '../../lib/supabase';
  import { initCloudSync } from '../../lib/cloud-sync';

  // Reconcile localStorage favorites + saved routines with the per-user cloud
  // copy (14.3b / 14.7). No-ops when logged out. Present on every page.
  initCloudSync();

  async function updateAuthUI() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const authButtons = document.getElementById('auth-buttons');
      const profileMenu = document.getElementById('profile-menu');
      const mobileAuth = document.getElementById('mobile-auth-buttons');
      const mobileProfile = document.getElementById('mobile-profile-links');

      if (session) {
        authButtons?.classList.add('hidden');
        authButtons?.classList.remove('md:flex');
        profileMenu?.classList.remove('hidden');
        mobileAuth?.classList.add('hidden');
        mobileProfile?.classList.remove('hidden');
      } else {
        // Keep the desktop auth buttons OFF on mobile (auth lives in the drawer):
        // `hidden md:flex` — never remove `hidden`, only toggle the md variant.
        authButtons?.classList.add('hidden');
        authButtons?.classList.add('md:flex');
        profileMenu?.classList.add('hidden');
        mobileAuth?.classList.remove('hidden');
        mobileProfile?.classList.add('hidden');
      }
    } catch {
      // Supabase not configured yet — show auth buttons by default
    }
  }

  // Profile dropdown toggle
  document.getElementById('profile-button')?.addEventListener('click', () => {
    document.getElementById('profile-dropdown')?.classList.toggle('hidden');
  });

  // Account dropdown toggle (logged-out state)
  document.getElementById('account-button')?.addEventListener('click', () => {
    const dd = document.getElementById('account-dropdown');
    const open = dd ? !dd.classList.toggle('hidden') : false;
    document.getElementById('account-button')?.setAttribute('aria-expanded', String(open));
  });

  // Close dropdowns on outside click
  document.addEventListener('click', (e) => {
    const profileMenu = document.getElementById('profile-menu');
    const dropdown = document.getElementById('profile-dropdown');
    if (profileMenu && dropdown && !profileMenu.contains(e.target as Node)) {
      dropdown.classList.add('hidden');
    }
    const accountWrap = document.getElementById('auth-buttons');
    const accountDd = document.getElementById('account-dropdown');
    if (accountWrap && accountDd && !accountWrap.contains(e.target as Node)) {
      accountDd.classList.add('hidden');
      document.getElementById('account-button')?.setAttribute('aria-expanded', 'false');
    }
  });

  // Logout handler
  async function handleLogout() {
    await supabase.auth.signOut();
    const lang = document.documentElement.lang === 'zh-CN' ? 'zh' : 'en';
    window.location.href = `/${lang}/`;
  }

  document.getElementById('logout-button')?.addEventListener('click', handleLogout);
  document.getElementById('mobile-logout-button')?.addEventListener('click', handleLogout);

  // Mobile menu toggle
  document.getElementById('mobile-menu-button')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });

  // Theme toggle (13.1) — flips .dark on <html> and persists the choice.
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {
      /* storage blocked — theme still applies for this session */
    }
  });

  updateAuthUI();

  supabase.auth.onAuthStateChange(() => {
    updateAuthUI();
  });
</script>
