---
import { icons } from './icons';

export interface Props {
  t: any;
}

const { t } = Astro.props;

const features = [
  { icon: icons.flask, title: t.home.feature_1_title, desc: t.home.feature_1_desc },
  { icon: icons.shieldCheck, title: t.home.feature_2_title, desc: t.home.feature_2_desc },
  { icon: icons.currencyDollar, title: t.home.feature_3_title, desc: t.home.feature_3_desc },
  { icon: icons.userCircle, title: t.home.feature_4_title, desc: t.home.feature_4_desc },
];
---

<section class="py-16 md:py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center sm:mb-16">
      <h2 class="text-2xl font-semibold text-foreground sm:text-3xl lg:text-4xl">
        {t.home.features_title}
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {features.map(f => (
        <div class="flex flex-col gap-4 rounded-xl border border-border bg-card p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg class="h-5 w-5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d={f.icon} />
            </svg>
          </div>
          <div>
            <h3 class="mb-1 font-semibold text-card-foreground">{f.title}</h3>
            <p class="text-sm text-muted-foreground">{f.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
