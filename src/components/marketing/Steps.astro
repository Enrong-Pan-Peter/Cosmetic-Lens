---
import { icons } from './icons';
import type { Language } from '../../i18n/utils';

export interface Props {
  lang: Language;
  t: any;
}

const { lang, t } = Astro.props;

const steps = [
  { num: '1', text: t.home.step_1 },
  { num: '2', text: t.home.step_2 },
  { num: '3', text: t.home.step_3 },
];
---

<section class="py-16 md:py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center sm:mb-16">
      <h2 class="font-display text-2xl font-medium text-foreground sm:text-3xl lg:text-4xl">
        {t.home.how_it_works}
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {steps.map(step => (
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border-2 border-border bg-secondary">
            <span class="text-lg font-semibold text-secondary-foreground">{step.num}</span>
          </div>
          <p class="text-muted-foreground">{step.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href={`/${lang}/chat`}
        class="inline-flex h-11 items-center justify-center rounded-lg bg-primary px-8 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        {t.home.cta_analyze}
        <svg class="ml-2 h-4 w-4" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d={icons.arrowRight} />
        </svg>
      </a>
    </div>
  </div>
</section>
