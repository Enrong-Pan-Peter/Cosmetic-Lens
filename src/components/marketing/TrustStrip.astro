---
export interface Props {
  t: any;
}

const { t } = Astro.props;

const partners = [
  t.home.trust_openai,
  t.home.trust_supabase,
  t.home.trust_obf,
  t.home.trust_pgvector,
];
---

<section class="border-y border-border/60 bg-card/40 py-6">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-5 sm:flex-row sm:justify-center sm:gap-10">
      <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        {t.home.trust_strip_label}
      </span>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
        {partners.map(p => (
          <span class="text-sm font-medium text-foreground/80">{p}</span>
        ))}
      </div>
    </div>
  </div>
</section>
