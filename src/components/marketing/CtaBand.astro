---
import { icons } from './icons';
import type { Language } from '../../i18n/utils';

export interface Props {
  lang: Language;
  t: any;
}

const { lang, t } = Astro.props;
---

<section class="bg-primary py-12 sm:py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-6 max-lg:flex-col max-lg:text-center">
      <div class="space-y-3">
        <h2 class="font-display text-2xl font-medium text-primary-foreground sm:text-3xl lg:text-4xl">
          {t.home.cta_band_title}
        </h2>
        <p class="text-lg text-primary-foreground/80">
          {t.home.cta_band_subtitle}
        </p>
      </div>
      <a
        href={`/${lang}/chat`}
        class="inline-flex h-11 shrink-0 items-center justify-center rounded-lg bg-secondary px-8 text-base font-medium text-secondary-foreground transition-colors hover:bg-secondary/80"
      >
        {t.home.cta_analyze}
        <svg class="ml-2 h-4 w-4" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d={icons.arrowRight} />
        </svg>
      </a>
    </div>
  </div>
</section>
