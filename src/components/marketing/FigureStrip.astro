---
/**
 * Figure strip (02g): three documentation plates under the hero.
 * 1 — the formulation bench (clinically graded product photo)
 * 2 — a real molecule structure (drawn from PubChem)
 * 3 — a real dupe pair, rendered live from curated-dupes.json
 * Rule: every picture depicts something real. No metaphor photos.
 */
import dupesData from '../../data/curated-dupes.json';

export interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
const isZh = lang === 'zh';

const pair = (dupesData.pairs as any[]).find(p => p.id === 'la-mer-cream');
const original = pair?.original;
const dupe = pair?.dupes?.find((d: any) => d.brand === 'Nivea') ?? pair?.dupes?.[0];
const dupeCount = (dupesData.pairs as any[]).length;

const figs = {
  f1: isZh ? '配方工作台' : 'The formulation bench',
  f2: isZh ? '烟酰胺 · 全能提亮成分' : 'Niacinamide · brightening workhorse',
  f3: isZh ? `平替档案：${original?.brand ?? 'La Mer'} 对比 ${dupe?.brand ?? 'Nivea'}` : `Dupe on file: ${original?.brand ?? 'La Mer'} vs ${dupe?.brand ?? 'Nivea'}`,
};

// Chinese names for the shared-base chips (fallback to the source string).
const ZH_INGREDIENT: Record<string, string> = {
  Petrolatum: '矿脂（凡士林）',
  Glycerin: '甘油',
  'Mineral Oil': '矿物油',
  Ceramides: '神经酰胺',
  'Hyaluronic Acid': '透明质酸',
};
const chipLabel = (s: string) => (isZh ? ZH_INGREDIENT[s] ?? s : s);
---

<section class="py-4">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-[1fr_1fr_1.5fr]">
      <!-- FIG. 01 · photo plate -->
      <figure class="overflow-hidden rounded-xl border border-border bg-card">
        <div class="h-52 overflow-hidden lg:h-56">
          <img
            src="/images/hero-lab-clinical.webp"
            alt={isZh ? '大理石台面上的护肤瓶与玻璃烧杯（冷色调）' : 'Skincare bottles and a beaker on a marble counter, neutral grade'}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <figcaption class="flex items-center gap-2.5 border-t border-border px-4 py-2.5">
          <span class="truncate text-[12.5px] text-muted-foreground">{figs.f1}</span>
        </figcaption>
      </figure>

      <!-- FIG. 02 · molecule plate (graph paper) -->
      <figure class="overflow-hidden rounded-xl border border-border bg-card">
        <div
          class="flex h-52 items-center justify-center lg:h-56"
          style="background-image:linear-gradient(hsl(var(--border)/.45) 1px,transparent 1px),linear-gradient(90deg,hsl(var(--border)/.45) 1px,transparent 1px);background-size:28px 28px;"
        >
          <img
            src="/images/molecules/niacinamide.svg"
            alt={isZh ? '烟酰胺分子结构式（PubChem CID 936）' : 'Skeletal structure of niacinamide, PubChem CID 936'}
            loading="lazy"
            decoding="async"
            class="h-[82%] w-auto dark:invert dark:hue-rotate-180"
          />
        </div>
        <figcaption class="flex items-center gap-2.5 border-t border-border px-4 py-2.5">
          <span class="truncate text-[12.5px] text-muted-foreground">{figs.f2}</span>
        </figcaption>
      </figure>

      <!-- FIG. 03 · dupe card, rendered from curated-dupes.json -->
      {original && dupe && (
        <figure class="overflow-hidden rounded-xl border border-border bg-card md:col-span-2 lg:col-span-1">
          <div class="flex h-auto flex-col justify-between px-5 py-4 lg:h-56">
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <div class="truncate font-display text-lg font-medium text-foreground">{original.product_name}</div>
                <div class="text-xs font-medium text-muted-foreground">{original.brand}</div>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="flex gap-1" aria-hidden="true">
                  {[0, 1, 2, 3, 4].map(() => (
                    <span class="h-2.5 w-5 rounded-[3px] bg-foreground"></span>
                  ))}
                </div>
                <span class="font-mono text-[10.5px] tracking-[0.06em] text-muted-foreground">{isZh ? '高价位' : 'LUXURY TIER'}</span>
              </div>
            </div>

            <div class="my-2.5 flex items-center gap-3" aria-hidden="true">
              <span class="h-px flex-1 bg-border"></span>
              <span class="font-mono text-[10px] tracking-[0.12em] text-metal">{isZh ? '同样的封闭保湿基底' : 'SAME PROTECTIVE BASE'}</span>
              <span class="h-px flex-1 bg-border"></span>
            </div>

            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <div class="truncate font-display text-lg font-medium text-foreground">{dupe.product_name}</div>
                <div class="text-xs font-medium text-muted-foreground">{dupe.brand}</div>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="flex gap-1" aria-hidden="true">
                  <span class="h-2.5 w-5 rounded-[3px] bg-brand"></span>
                  {[0, 1, 2, 3].map(() => (
                    <span class="h-2.5 w-5 rounded-[3px] border border-input"></span>
                  ))}
                </div>
                <span class="font-mono text-[10.5px] tracking-[0.06em] text-muted-foreground">{isZh ? '平价位' : 'BUDGET TIER'}</span>
              </div>
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-1.5">
              <span class="mr-1 font-mono text-[10px] tracking-[0.1em] text-metal">{isZh ? '共同成分' : 'SHARED'}</span>
              {(dupe.key_similarities ?? []).slice(0, 3).map((s: string) => (
                <span class="rounded-md border border-accent-foreground/20 bg-accent px-2 py-0.5 text-xs font-semibold text-accent-foreground">{chipLabel(s)}</span>
              ))}
            </div>
          </div>
          <figcaption class="flex items-center gap-2.5 border-t border-border px-4 py-2.5">
              <span class="truncate text-[12.5px] text-muted-foreground">{figs.f3}</span>
            <span class="ml-auto hidden font-mono text-[10px] text-muted-foreground/80 sm:block">{isZh ? `30 组平替之一` : `1 OF ${dupeCount} ON FILE`}</span>
          </figcaption>
        </figure>
      )}
    </div>
  </div>
</section>
