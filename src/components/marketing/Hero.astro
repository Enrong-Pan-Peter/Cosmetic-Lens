---
import { icons } from './icons';
import type { Language } from '../../i18n/utils';

export interface Props {
  lang: Language;
  t: any;
}

const { lang, t } = Astro.props;
const isZh = lang === 'zh';

// Sample report rows shown inside the analyzer card (static preview; the
// card links to the real analyzer). Inline bilingual per StatBand precedent.
// Chinese labels list ingredients in Chinese, so the zh sample mirrors a real
// back label (Chinese names first) rather than showing raw INCI to zh users.
const sampleRows = [
  {
    name: isZh ? '烟酰胺' : 'Niacinamide',
    role: isZh ? '美白提亮 · 修护屏障' : 'Brightening · barrier support',
    verdict: 'safe',
    label: isZh ? '安全' : 'Safe',
  },
  {
    name: isZh ? '神经酰胺 NP' : 'Ceramide NP',
    role: isZh ? '屏障修护' : 'Barrier repair',
    verdict: 'safe',
    label: isZh ? '安全' : 'Safe',
  },
  {
    name: isZh ? '香精' : 'Fragrance (Parfum)',
    role: isZh ? '致敏风险' : 'Known sensitizer',
    verdict: 'caution',
    label: isZh ? '注意' : 'Caution',
  },
];
---

<section class="relative overflow-hidden">
  <!-- Faint graph-paper grid, faded at the edges -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 opacity-60"
    style="background-image:linear-gradient(hsl(var(--border)/.55) 1px,transparent 1px),linear-gradient(90deg,hsl(var(--border)/.55) 1px,transparent 1px);background-size:44px 44px;-webkit-mask-image:radial-gradient(80% 90% at 50% 8%,#000 35%,transparent 80%);mask-image:radial-gradient(80% 90% at 50% 8%,#000 35%,transparent 80%);"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 md:py-16 lg:py-20">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Text column -->
      <div class="lg:col-span-6">
        <span class="text-[11px] font-bold uppercase tracking-[0.22em] text-foreground/70">
          {t.home.hero_badge}
        </span>

        <h1 class="mt-5 font-display font-medium text-4xl leading-[1.14] tracking-normal text-foreground sm:text-5xl lg:text-[3.4rem]">
          {t.home.hero_title_pre}{
            isZh ? (
              <span class="text-brand">{t.home.hero_title_accent}</span>
            ) : (
              <em class="italic">{t.home.hero_title_accent}</em>
            )
          }{t.home.hero_title_post}
        </h1>

        <p class="mt-6 max-w-xl text-lg text-muted-foreground">
          {t.home.hero_subtitle}
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={`/${lang}/chat`}
            class="inline-flex h-12 items-center justify-center rounded-lg bg-primary px-8 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
          >
            <svg class="mr-2 h-4 w-4" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d={icons.microscope} />
            </svg>
            {t.home.cta_analyze}
          </a>
          <a
            href={`/${lang}/glossary`}
            class="inline-flex h-12 items-center justify-center gap-2 px-2 text-base font-semibold text-foreground underline decoration-border underline-offset-8 transition-colors hover:decoration-foreground"
          >
            <svg class="h-4 w-4" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d={icons.bookOpen} />
            </svg>
            {t.home.cta_learn}
          </a>
        </div>
      </div>

      <!-- Analyzer card: a real input. Typing here carries into the chat page. -->
      <div class="lg:col-span-6">
        <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-xl shadow-foreground/5">
          <!-- Tabs: the other two modes live on the analyzer page -->
          <div class="flex border-b border-border bg-muted/60 text-[13px] font-semibold">
            <a href={`/${lang}/chat`} class="border-r border-border px-4 py-3 text-muted-foreground transition-colors hover:text-foreground">{t.home.analyzer_tab_name}</a>
            <span class="border-r border-border bg-card px-4 py-3 text-brand shadow-[inset_0_2px_0_hsl(var(--brand))]">{t.home.analyzer_tab_paste}</span>
            <a href={`/${lang}/chat`} class="border-r border-border px-4 py-3 text-muted-foreground transition-colors hover:text-foreground">{t.home.analyzer_tab_photo}</a>
          </div>

          <form id="hero-analyzer" data-chat-href={`/${lang}/chat`} class="p-4 sm:p-5">
            <label class="sr-only" for="hero-analyzer-input">{t.chat.placeholder}</label>
            <textarea
              id="hero-analyzer-input"
              rows="2"
              placeholder={isZh
                ? '粘贴成分表，例如：水、甘油、烟酰胺、神经酰胺 NP、透明质酸钠……'
                : 'Paste an ingredient list, e.g. Aqua, Glycerin, Niacinamide, Ceramide NP, Sodium Hyaluronate…'}
              class="w-full resize-none rounded-lg border border-input bg-card px-4 py-3.5 font-mono text-base leading-relaxed text-foreground placeholder:text-muted-foreground/70 sm:text-[12.5px]"
            ></textarea>
            <div class="mt-4 flex items-center justify-between gap-3">
              <span class="inline-flex items-center gap-2 text-[12.5px] text-muted-foreground">
                <svg class="h-4 w-4 text-safe" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                  <path d={icons.shieldCheck} />
                </svg>
                {t.home.analyzer_note}
              </span>
              <button
                type="submit"
                class="inline-flex h-10 items-center justify-center rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
              >
                {t.home.analyzer_button}
                <svg class="ml-2 h-4 w-4" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                  <path d={icons.arrowRight} />
                </svg>
              </button>
            </div>
          </form>

          <!-- Sample report -->
          <div class="border-t border-dashed border-border bg-muted/40 px-4 pb-4 pt-3 sm:px-5">
            <span class="text-[10.5px] font-bold uppercase tracking-[0.14em] text-muted-foreground/80">
              {t.home.analyzer_sample}
            </span>
            {sampleRows.map(row => (
              <div class="mt-2 flex items-center gap-3 text-[13px]">
                <span class="w-[38%] min-w-0 truncate font-semibold text-foreground sm:w-[200px]">{row.name}</span>
                <span class="hidden flex-1 text-xs text-muted-foreground sm:block">{row.role}</span>
                <span
                  class={`ml-auto inline-flex items-center gap-1 rounded-md border px-2.5 py-0.5 text-xs font-semibold ${
                    row.verdict === 'safe'
                      ? 'border-safe/25 bg-safe-bg text-safe'
                      : 'border-caution/30 bg-caution-bg text-caution'
                  }`}
                >
                  {row.verdict === 'safe' ? (
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l5 5 10-11" />
                    </svg>
                  ) : (
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" d="M12 8v5.2M12 16.8v.2" />
                      <circle cx="12" cy="12" r="9" />
                    </svg>
                  )}
                  {row.label}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Hero analyzer: carry the typed ingredient list into the chat page and ask
  // it immediately. ChatInterface consumes `cl:prefill` (+ the send flag) on
  // mount and runs the same code path as pressing Send.
  const form = document.getElementById('hero-analyzer');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const ta = form.querySelector('textarea');
    const value = (ta?.value ?? '').trim();
    try {
      if (value) {
        sessionStorage.setItem('cl:prefill', value);
        sessionStorage.setItem('cl:prefill-send', '1');
      }
    } catch {
      /* private mode: fall through to plain navigation */
    }
    window.location.href = (form as HTMLFormElement).dataset.chatHref || '/';
  });
</script>
