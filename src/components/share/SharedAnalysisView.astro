---
import AnalysisDisplay from '../chat/AnalysisDisplay.jsx';

interface SharedRow {
  id: string;
  title?: string | null;
  content: string;
  language?: string | null;
  metadata?: Record<string, any> | null;
  created_at?: string | null;
}

interface Props {
  row: SharedRow;
  lang: 'en' | 'zh';
}

const { row, lang } = Astro.props;
const meta = row.metadata ?? {};
const product = meta.product ?? null;
const dupes = Array.isArray(meta.dupes) ? meta.dupes : undefined;
const sources = Array.isArray(meta.sources) ? meta.sources : [];
const created = row.created_at ? new Date(row.created_at).toISOString().slice(0, 10) : null;
---

<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
  <!-- Shared-from banner -->
  <div class="mb-6 flex items-center justify-between gap-3 flex-wrap">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
      {lang === 'zh' ? '来自 成分透视 的分享' : 'Shared from CosmeticLens'}
    </span>
    <div class="flex items-center gap-3">
      {created && <span class="text-xs text-muted-foreground">{created}</span>}
      <button
        id="download-pdf"
        type="button"
        class="print-hide inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-medium text-foreground hover:bg-accent transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
        </svg>
        {lang === 'zh' ? '下载 PDF' : 'Download PDF'}
      </button>
    </div>
  </div>

  <script>
    document.getElementById('download-pdf')?.addEventListener('click', () => window.print());
  </script>

  {row.title && (
    <h1 class="text-xl font-semibold text-foreground mb-1">{row.title}</h1>
  )}
  {product?.name && (
    <p class="text-sm text-muted-foreground mb-4">
      {product.name}{product.brand ? ` · ${product.brand}` : ''}
    </p>
  )}

  <div class="rounded-xl border border-border bg-card p-4 sm:p-6 shadow-sm">
    <AnalysisDisplay
      client:load
      content={row.content}
      lang={lang}
      dupes={dupes}
      intent={meta.intent}
      stopped={false}
      streaming={false}
      prevUserContent={product?.name ?? undefined}
      onFindDupes={undefined}
      onSimilarIngredients={undefined}
    />

    {sources.length > 0 && (
      <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-border pt-3">
        <span class="text-[11px] text-muted-foreground">{lang === 'zh' ? '资料来源' : 'Sources'}:</span>
        {sources.slice(0, 8).map((s: any) => (
          <span class="inline-flex items-center rounded-full bg-muted border border-border px-2 py-0.5 text-[11px] text-muted-foreground">
            {s.type ? `${s.type} · ` : ''}{s.name}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- CTA -->
  <section class="print-hide mt-6 rounded-xl border border-primary/20 bg-primary/5 p-5 text-center">
    <h2 class="text-base font-semibold text-foreground">
      {lang === 'zh' ? '想分析你自己的产品？' : 'Want to analyze your own product?'}
    </h2>
    <p class="text-sm text-muted-foreground mt-1">
      {lang === 'zh'
        ? '粘贴任意成分表，获取成分解读、宣传核实与平价替代。'
        : 'Paste any ingredient list for a breakdown, claim checks, and affordable dupes.'}
    </p>
    <a
      href={`/${lang}/chat`}
      class="mt-3 inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
    >
      {lang === 'zh' ? '开始分析' : 'Try it free'}
    </a>
  </section>

  <p class="mt-4 text-xs text-muted-foreground/80">
    {lang === 'zh'
      ? '成分分析仅供参考，不构成医疗建议。'
      : 'Ingredient analysis is for reference only, not medical advice.'}
  </p>
</article>
